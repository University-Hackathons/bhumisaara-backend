# ─────────────────────────────────────────────────────────────────────────────
# BhumiSaara — backend environment template
#
# Copy this file to `.env.development` (the profile the app runs under by
# default) and fill in your own values. `.env*` is gitignored; this template is
# the only env file committed, and it contains no real credentials.
#
#   cp Example.env .env.development
#
# Loaded by me.paulschwarz:spring-dotenv at startup and referenced from
# src/main/resources/application-<profile>.yml as ${VAR_NAME}.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL. Create an empty database first; Hibernate generates the schema
# on boot (ddl-auto: update under the development profile).
DB_URL=jdbc:postgresql://localhost:5432/bhumisaara
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# ── JWT ─────────────────────────────────────────────────────────────────────
# JWT_SECRET must be a Base64-encoded string of at least 256 bits — HS256 keys
# are built with Keys.hmacShaKeyFor(Decoders.BASE64.decode(secret)), so a short
# or non-Base64 value fails at startup. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=replace_with_a_base64_encoded_256_bit_secret
# Milliseconds.
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. The Next.js dev server is
# on 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
